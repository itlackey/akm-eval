#!/usr/bin/env bash
# Runs the LongMemEval benchmark. See README.md.
#
#   benchmarks/longmemeval/run [--corpus public|private|all] [--limit N] [--label NAME]
#                              [--sample-seed N] [--retrieval-only] [--resume DIR]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

# Settings come from .env at the repository root: KEY=value lines. A variable that is already set wins. See lib/env.sh.
source lib/env.sh

command -v bun > /dev/null || { echo "longmemeval: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/run.ts" "$@"
