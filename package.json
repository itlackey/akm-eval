{
  "name": "@akm/eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "bin": {
    "akm-eval": "./bin/akm-eval",
    "akm-eval-compare": "./bin/compare",
    "akm-eval-doctor": "./bin/doctor",
    "akm-eval-downloads": "./bin/downloads",
    "akm-eval-eval": "./bin/eval",
    "akm-eval-matrix": "./bin/matrix",
    "akm-eval-report": "./bin/report",
    "akm-eval-setup": "./bin/setup",
    "akm-eval-summary": "./bin/summary"
  },
  "scripts": {
    "akm-eval": "bash bin/akm-eval",
    "start": "bash bin/akm-eval",
    "setup": "bash bin/setup",
    "setup:legacy": "bun src/cli.ts setup",
    "doctor": "bash bin/doctor",
    "eval": "bash bin/eval",
    "matrix": "bash bin/matrix",
    "compare": "bash bin/compare",
    "report": "bash bin/report",
    "summary": "bash bin/summary",
    "downloads": "bash bin/downloads",
    "download:datasets": "bun run downloads",
    "beam:doctor": "bash bin/beam-doctor",
    "docker:build": "bash bin/build-image",
    "check:boundary": "bun scripts/check-boundary.ts",
    "test": "bun test",
    "check": "bun run check:boundary && bun test",
    "lint": "biome check src tests scripts",
    "format": "biome format --write src tests scripts"
  }
}
