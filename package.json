{
  "name": "@akm/eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "bin": {
    "akm-eval": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "doctor": "bun src/cli.ts doctor",
