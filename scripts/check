#!/usr/bin/env bash
# Runs every check of the repository, the ones CI runs, and stops at the first one that fails. See README.md ("Check the repository").
#
#   scripts/check [typecheck] [python] [test]
#
# With no name it runs all three, the quick ones first:
#   typecheck  bun install --frozen-lockfile at the root (and in a src folder with a package.json of its own), then tsc in every src folder
#              that has a tsconfig.json
#   python     the tests of the akm arm in lib/harbor, with uv
#   test       bun test at the root. Every test uses a fake akm, so none needs akm or Docker, and an akm on PATH or an AKM_BIN in the
#              environment changes nothing. The few tests that run a real akm run only with AKM_EVAL_REAL_AKM=1
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
cd "$root"

# The header: the comment lines that follow the shebang, up to the first line that is not one.
usage() { sed -n '2,${/^#/!q;s/^# \{0,1\}//;p;}' "${BASH_SOURCE[0]}"; }

run_typecheck() {
  local tsconfig dir found=0
  bun install --frozen-lockfile || { echo "check: bun install failed" >&2; return 1; }
  for tsconfig in evals/*/src/tsconfig.json benchmarks/*/src/tsconfig.json scripts/*/src/tsconfig.json; do
    [ -f "$tsconfig" ] || continue
    dir="$(dirname "$tsconfig")"
    found=1
    echo "-- $dir"
    if [ -f "$dir/package.json" ]; then (cd "$dir" && bun install --frozen-lockfile --ignore-scripts) || { echo "check: bun install in $dir failed" >&2; return 1; }; fi
    "$root/node_modules/.bin/tsc" --noEmit -p "$tsconfig" || { echo "check: the typecheck of $dir failed" >&2; return 1; }
  done
  [ "$found" = 1 ] || { echo "check: found no src folder with a tsconfig.json" >&2; return 1; }
}

run_python() {
  command -v uv > /dev/null || { echo "check: uv is needed for the Python suites. See https://docs.astral.sh/uv/" >&2; return 1; }
  # The Harbor release is pinned in lib/harbor/harbor.ts, once; lib/harbor/pin.ts reads it.
  local harbor
  harbor="$(bun lib/harbor/pin.ts harbor)"
  [ -n "$harbor" ] || { echo "check: could not read the Harbor pin from lib/harbor/harbor.ts" >&2; return 1; }
  uv run --no-project --python 3.12 --with "harbor==$harbor" --with pytest pytest lib/harbor || return 1
}

run_test() {
  # bunfig.toml has no [test] timeout (bun 1.4 ignores one), so it is a flag. The 5 s default is too short under load for the tests
  # that start a fake akm many times (the retrieval fixtures).
  bun test --timeout=120000
}

checks=("$@")
case "${checks[0]:-}" in -h | --help) usage; exit 0 ;; esac
[ "${#checks[@]}" -gt 0 ] || checks=(typecheck python test)
for name in "${checks[@]}"; do
  case "$name" in typecheck | python | test) ;; *) echo "check: unknown check \"$name\"" >&2; usage >&2; exit 2 ;; esac
done
command -v bun > /dev/null || { echo "check: bun is needed. See https://bun.sh" >&2; exit 2; }

for name in "${checks[@]}"; do
  printf '\n==> check %s\n' "$name"
  "run_$name" || {
    printf '\ncheck: FAILED at "%s". The checks after it did not run.\n' "$name" >&2
    exit 1
  }
done
printf '\ncheck: all passed (%s)\n' "${checks[*]}"
