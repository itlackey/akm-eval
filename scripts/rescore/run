#!/usr/bin/env bash
# Scores stored results folders again with the current scorer and labels of their eval, into new folders beside them. See the README's "Run, save, compare".
#
#   scripts/rescore/run [--cases DIR] RESULTS_DIR...
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command -v bun > /dev/null || { echo "rescore: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/run.ts" "$@"
