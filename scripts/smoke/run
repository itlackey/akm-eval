#!/usr/bin/env bash
# Runs each eval that drives akm once, on one case, against a stub model. See README.md.
#
#   scripts/smoke/run [--only A,B] [--skip A,B] [--akm COMMAND] [--timeout SEC] [--strict] [--keep] [--list]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

# Settings come from .env at the repository root: KEY=value lines. Nonempty .env values win over the shell; blank values retain shell values. See lib/env.sh.
source lib/env.sh

command -v bun > /dev/null || { echo "smoke: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/run.ts" "$@"
