# Copy this file to .env and fill it in. .env is gitignored. Never commit it.
# Every run, generate and label script, and generate-assets, reads it (lib/env.sh) as KEY=value lines. A variable that is
# already set in your shell wins, a line may start with `export `, and an unquoted value ends at a ` #` comment.

# The model under test. Any OpenAI-compatible endpoint works, local or cloud. Point it at one gateway
# (such as https://gateway.example.com/v1) and pick the model of a run with --model ID, the gateway's model id, such as
# my-model. MODEL_NAME is the model of a run without --model.
# Local example: http://localhost:8080/v1. Cloud example: https://api.openai.com/v1
# A model that is not behind the gateway, or that may see your private notes ("private": true), goes in models.json (copy models.example.json), not in a script.
MODEL_BASE_URL=http://localhost:8080/v1
MODEL_API_KEY=
MODEL_NAME=
# evals/agent-ab and benchmarks/terminal-bench run opencode, which calls the Responses API. They resolve --model like the other evals
# and accept the opencode form of a name, provider/model, such as openai/gpt-6-luna. OPENAI_BASE_URL and OPENAI_API_KEY stand in for an
# empty MODEL_BASE_URL and MODEL_API_KEY, in any combination, and MODEL_* wins when both are set. Only the model's variables and
# Harbor's own reach Harbor.

# The judge model, for evals that grade answers with a model (--judge-model ID). Without JUDGE_BASE_URL and JUDGE_API_KEY
# the judge uses the model's endpoint and key.
JUDGE_BASE_URL=http://localhost:8080/v1
JUDGE_API_KEY=
JUDGE_MODEL=

# The akm that the evals using akm run. Default: akm on PATH. --akm COMMAND does the same for one run.
# For a checkout, name a command: AKM_BIN="bun /path/to/akm/src/cli.ts". A leading ~/ in a word is your home folder:
# AKM_BIN="bun ~/code/akm/src/cli.ts". evals/agent-ab and benchmarks/terminal-bench do not read it: their --akm is a release
# (akm-cli@x.y.z) or the folder of a checkout, which runs in a container.
# AKM_BIN=akm
