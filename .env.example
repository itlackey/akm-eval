# Agent arms through OpenCode Zen.
OPENCODE_API_KEY=

# LongMemEval's required gpt-4o judge. Keep this distinct from the Zen key.
AKM_EVAL_JUDGE_API_KEY=

# Optional ai.lab answer endpoint used by the 0.9.15 fragment-context config.
LAB_AI_BASE_URL=
LAB_API_KEY=

# Provider-neutral local answer endpoints used by config/reference/*.json.
AKM_EVAL_BASELINE_BASE_URL=http://qwen-baseline:8080/v1
AKM_EVAL_RETRIEVAL_BASE_URL=http://qwen-retrieval:8080/v1
# llama.cpp accepts a placeholder; use a real key for a protected endpoint.
AKM_EVAL_AGENT_API_KEY=local

# Optional operator-supplied identity for a mutable/aliased judge deployment.
# AKM_EVAL_JUDGE_RUNTIME_FINGERPRINT=

# Optional: only set these when the judge is served by a compatible endpoint.
# AKM_EVAL_JUDGE_BASE_URL=
