{
  "api_key_env": "OPENAI_API_KEY",
  "default_config": "lore_search",
  
  "configs": {
    "lore_search": {
      "endpoint": "embeddings",
      "model": "text-embedding-3-small",
      "params": {
        "dimensions": 512
      },
      "context_strategy": "relevant",
      "max_tokens": 4000
    },
    
    "deep_lore_analysis": {
      "endpoint": "embeddings",
      "model": "text-embedding-3-large",
      "params": {
        "dimensions": 3072
      },
      "context_strategy": "full",
      "max_tokens": 8000
    },
    
    "content_moderate": {
      "endpoint": "moderation",
      "model": "omni-moderation-latest",
      "auto_invoke": false
    },
    
    "lore_generation": {
      "endpoint": "chat",
      "model": "gpt-4o",
      "params": {
        "temperature": 0.7,
        "max_tokens": 2000
      },
      "system_prompt": "You are a dark fantasy TTRPG lore writer specializing in dark-fantasy settings. Your writing is evocative, atmospheric, and maintains consistency with established lore.",
      "context_strategy": "full"
    },
    
    "mechanics_assistant": {
      "endpoint": "chat",
      "model": "gpt-4o",
      "params": {
        "temperature": 0.3,
        "max_tokens": 1500
      },
      "system_prompt": "You are a TTRPG game mechanics expert. You help balance game mechanics, suggest rules clarifications, and ensure mechanical consistency.",
      "context_strategy": "relevant"
    }
  },
  
  "endpoints": {
    "embeddings": {
      "path": "/v1/embeddings",
      "base_url": "https://api.openai.com",
      "default_model": "text-embedding-3-small",
      "description": "Generate embeddings for semantic search through lore and mechanics",
      "required_params": ["input"],
      "optional_params": ["model", "encoding_format", "dimensions", "user"],
      "supports_batch": true,
      "max_batch_size": 2048,
      "cost_per_1k_tokens": {
        "text-embedding-3-small": 0.00002,
        "text-embedding-3-large": 0.00013
      }
    },
    
    "moderation": {
      "path": "/v1/moderations",
      "base_url": "https://api.openai.com",
      "default_model": "omni-moderation-latest",
      "description": "Check community-submitted content for policy violations",
      "required_params": ["input"],
      "optional_params": ["model"],
      "supports_batch": false,
      "output_schema": {
        "flagged": "boolean",
        "categories": "object",
        "category_scores": "object"
      },
      "cost_per_1k_tokens": {
        "omni-moderation-latest": 0.0
      }
    },
    
    "chat": {
      "path": "/v1/chat/completions",
      "base_url": "https://api.openai.com",
      "default_model": "gpt-4o",
      "description": "Generate lore, mechanics, and content with specialized prompting",
      "required_params": ["messages"],
      "optional_params": ["model", "temperature", "max_tokens", "top_p", "frequency_penalty", "presence_penalty"],
      "supports_streaming": true,
      "cost_per_1k_tokens": {
        "gpt-4o": {
          "input": 0.0025,
          "output": 0.01
        }
      }
    }
  },
  
  "budget": {
    "max_tokens_per_request": 10000,
    "max_tokens_per_session": 150000,
    "warn_at_tokens": 100000
  }
}
