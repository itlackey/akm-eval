{
  "api_key_env": "OPENAI_API_KEY",
  "default_config": "code_search",
  
  "configs": {
    "code_search": {
      "endpoint": "embeddings",
      "model": "text-embedding-3-small",
      "params": {
        "dimensions": 512
      },
      "context_strategy": "relevant",
      "max_tokens": 3000
    },
    
    "architectural_analysis": {
      "endpoint": "embeddings",
      "model": "text-embedding-3-large",
      "params": {
        "dimensions": 3072
      },
      "context_strategy": "full",
      "max_tokens": 8000
    },
    
    "code_review": {
      "endpoint": "chat",
      "model": "gpt-4o",
      "params": {
        "temperature": 0.2,
        "max_tokens": 2000
      },
      "system_prompt": "You are an expert code reviewer. Focus on: correctness, performance, security, maintainability, and best practices. Be constructive and specific.",
      "context_strategy": "relevant"
    },
    
    "documentation": {
      "endpoint": "chat",
      "model": "gpt-4o-mini",
      "params": {
        "temperature": 0.3,
        "max_tokens": 1500
      },
      "system_prompt": "You are a technical documentation writer. Create clear, concise, and accurate documentation. Include examples and edge cases.",
      "context_strategy": "relevant"
    },
    
    "test_generation": {
      "endpoint": "chat",
      "model": "gpt-4o-mini",
      "params": {
        "temperature": 0.4,
        "max_tokens": 2000
      },
      "system_prompt": "You are a test engineer. Generate comprehensive test cases covering happy paths, edge cases, and error conditions. Follow testing best practices.",
      "context_strategy": "relevant"
    }
  },
  
  "endpoints": {
    "embeddings": {
      "path": "/v1/embeddings",
      "base_url": "https://api.openai.com",
      "default_model": "text-embedding-3-small",
      "description": "Search codebase semantically, find similar implementations",
      "required_params": ["input"],
      "optional_params": ["model", "dimensions"],
      "supports_batch": true,
      "max_batch_size": 2048,
      "cost_per_1k_tokens": {
        "text-embedding-3-small": 0.00002,
        "text-embedding-3-large": 0.00013
      }
    },
    
    "chat": {
      "path": "/v1/chat/completions",
      "base_url": "https://api.openai.com",
      "default_model": "gpt-4o",
      "description": "Code review, documentation generation, test creation",
      "required_params": ["messages"],
      "optional_params": ["model", "temperature", "max_tokens"],
      "supports_streaming": true,
      "cost_per_1k_tokens": {
        "gpt-4o": {
          "input": 0.0025,
          "output": 0.01
        },
        "gpt-4o-mini": {
          "input": 0.00015,
          "output": 0.0006
        }
      }
    }
  },
  
  "budget": {
    "max_tokens_per_request": 8000,
    "max_tokens_per_session": 100000,
    "warn_at_tokens": 80000
  }
}
