#!/usr/bin/env bash
# Makes this eval's private assets from the public ones. ./generate-assets calls it. See README.md.
#
#   evals/bakeoff/generate --seed N --out private/bakeoff
#
# The files the cases read are rewritten first, then cases.json with the same map, so every name in
# the files, the file names and what a correct reply holds changes the same way.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

# Settings come from .env at the repository root: KEY=value lines. A variable that is already set wins. See lib/env.sh.
source lib/env.sh

seed=""
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    --seed) [ $# -ge 2 ] || { echo "bakeoff: --seed needs a value" >&2; exit 2; }; seed="$2"; shift 2 ;;
    --out) [ $# -ge 2 ] || { echo "bakeoff: --out needs a value" >&2; exit 2; }; out="$2"; shift 2 ;;
    *) echo "Usage: evals/bakeoff/generate --seed N --out private/bakeoff" >&2; exit 2 ;;
  esac
done
[ -n "$seed" ] && [ -n "$out" ] || { echo "Usage: evals/bakeoff/generate --seed N --out private/bakeoff" >&2; exit 2; }

command -v bun > /dev/null || { echo "bakeoff: bun is needed. See https://bun.sh" >&2; exit 2; }
command -v uv > /dev/null || { echo "bakeoff: uv is needed. See https://docs.astral.sh/uv/" >&2; exit 2; }

# Everything is made in a work folder beside the result, and moved into place only when the check passes, so a generation that fails
# leaves the earlier assets, map and generated.json as they were. The marker goes out first and comes in last: assets cut short with
# no marker are refused by run --corpus private.
mkdir -p "$out"
work="$(mktemp -d "$out/.work.XXXXXX")"
trap 'rm -rf "$work"' EXIT
staged="$work/staged"
mkdir -p "$work/corpus" "$staged"

# The files, without cases.json: the words in it must not decide which names are names.
cp -R "$here/assets/." "$work/corpus/"
rm "$work/corpus/cases.json"
bun lib/rewrite/rewrite.ts --seed "$seed" --map "$staged/map.json" "$work/corpus" "$staged/assets"
bun lib/rewrite/rewrite.ts --map "$staged/map.json" "$here/assets/cases.json" "$staged/assets/cases.json"

uv run --project "$here/src" --frozen python "$here/src/bakeoff.py" check-assets "$staged/assets" --against "$here/assets" --stamp "$seed"

rm -f "$out/generated.json"
rm -rf "$out/assets" "$out/map.json"
mv "$staged/assets" "$out/assets"
mv "$staged/map.json" "$out/map.json"
mv "$staged/generated.json" "$out/generated.json"
