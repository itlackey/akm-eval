#!/usr/bin/env bash
# Runs the bakeoff eval. See README.md.
#
#   evals/bakeoff/run [--corpus public|private|all] [--limit N] [--tier compact|deep] [--label NAME] [--models FILE]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

# Settings come from .env at the repository root: KEY=value lines. A variable that is already set wins. See lib/env.sh.
source lib/env.sh

command -v uv > /dev/null || { echo "bakeoff: uv is needed. See https://docs.astral.sh/uv/" >&2; exit 2; }
exec uv run --project "$here/src" --frozen python "$here/src/bakeoff.py" run "$@"
