{"parentUuid":"1fec4756-f4b5-44b7-99d6-c5cadf8d21bd","isSidechain":false,"userType":"external","cwd":"/home/dev/harborlight","sessionId":"insight-08","version":"2.0.21","gitBranch":"fix/alb-502","type":"assistant","message":{"id":"msg_01LkvzMf79R9L1Nikeckw8eY","type":"message","role":"assistant","model":"claude-sonnet-4-5","content":[{"type":"text","text":"Each 502 has a target_processing_time of -1 and no target status code: the ALB picked a target, sent the request and the connection was closed before any response came back. The app never saw a request, which is why its logs are clean. That pattern usually means the ALB reused an idle keep-alive connection that the target had just closed. Let me compare the two idle timeouts."}],"stop_reason":"end_turn","usage":{"input_tokens":862,"output_tokens":100}},"uuid":"6cfa65b3-1800-4b7f-a596-f4fcaac78531","timestamp":"2026-09-17T13:06:01.000Z","requestId":"req_011CHPsy6ingueoERnAuH6Tk"}
