{"parentUuid":"5eb2bac6-7d5b-4002-ace3-ec91c65008e0","isSidechain":false,"userType":"external","cwd":"/home/dev/harborlight","sessionId":"preference-08","version":"2.0.21","gitBranch":"feat/mooring-locks","type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_01d9fSAXpdo9KdwD4FyFNMcZ","content":"+export async function acquireLock(name: string, ttlMs = 30_000): Promise<Lock | null> {\n+  const path = lockPath(name);\n+  if (existsSync(path)) {\n+    const held = JSON.parse(readFileSync(path, \"utf8\")) as LockFile;\n+    if (Date.now() < held.expires) return null;\n+  }\n+  writeFileSync(path, JSON.stringify({ pid: process.pid, expires: Date.now() + ttlMs }));\n+  return { name, release: () => unlinkSync(path) };\n+}\n+\n+export function lockPath(name: string): string {\n+  return join(harborDir(), \"locks\", `${name}.json`);\n+}"}]},"uuid":"ee24e8bb-1f42-4d1f-a954-119e16616a49","timestamp":"2026-09-26T09:05:59.000Z"}
