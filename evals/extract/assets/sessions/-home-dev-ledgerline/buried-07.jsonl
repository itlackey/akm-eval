{"parentUuid":"5b72c316-634e-48a8-a43c-b365613ba374","isSidechain":false,"userType":"external","cwd":"/home/dev/ledgerline","sessionId":"buried-07","version":"2.0.14","gitBranch":"report/q3-active","type":"assistant","message":{"id":"msg_01mthyq4y5Tooga2vCA4plmC","type":"message","role":"assistant","model":"claude-sonnet-4-5","content":[{"type":"tool_use","id":"toolu_01ZJQ3gKlq2rlpWbOu2DhNJA","name":"Write","input":{"file_path":"/home/dev/ledgerline/scripts/reports/q3_active.py","content":"\"\"\"Q3 2026 active customers by plan and region, for the board pack.\n\nA customer counts when the CRM export says active and Ledgerline has a paid invoice dated in Q3.\n\"\"\"\nimport os\n\nimport pandas as pd\nimport sqlalchemy as sa\n\nCRM = \"data/crm/customers_2026-09-30.csv\"\nOUT = \"data/reports/q3_active.csv\"\nQ3 = (\"2026-07-01\", \"2026-10-01\")\n\n\ndef load_crm() -> pd.DataFrame:\n    df = pd.read_csv(CRM, dtype=str, keep_default_na=False)\n    df = df.apply(lambda s: s.str.strip())\n    return df\n\n\ndef paid_in_q3() -> set[str]:\n    engine = sa.create_engine(os.environ[\"LEDGER_REPLICA_URL\"])\n    q = sa.text(\"select distinct customer_id::text from invoices where status = 'paid' and issued_at >= :a and issued_at < :b\")\n    with engine.connect() as c:\n        return {r[0] for r in c.execute(q, {\"a\": Q3[0], \"b\": Q3[1]})}\n\n\ndef active(df: pd.DataFrame, paid: set[str]) -> pd.DataFrame:\n    return df[(df[\"status\"] == \"active\") & df[\"ledger_customer_id\"].isin(paid)]\n\n\nif __name__ == \"__main__\":\n    crm = load_crm()\n    act = active(crm, paid_in_q3())\n    print(len(act), \"active\")\n    print(act.groupby(\"region\").size())\n"}}],"stop_reason":"tool_use","usage":{"input_tokens":621,"output_tokens":334}},"uuid":"400fc7cd-78a4-4009-82fe-7a6b97f5770c","timestamp":"2026-10-07T08:47:46.000Z","requestId":"req_011ChMYdSvJg4TJUDhMWsgx4"}
