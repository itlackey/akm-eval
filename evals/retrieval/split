#!/usr/bin/env bash
# Writes the split corpus of the selection suite: the public library as two bundles, with the queries repeated once for each selection.
# See assets/selection-split/README.md.
#
#   evals/retrieval/split DIR     (outside any gitignored folder: akm indexes no ignored file)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

command -v bun > /dev/null || { echo "retrieval: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/split.ts" "$@"
