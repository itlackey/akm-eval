#!/usr/bin/env bash
# Grades the pooled results for each task query with the judge model, into assets/qrels.jsonl, or with --cases DIR into the
# qrels.jsonl of that folder. With --from it grades the results of a run, the semantic search included. See README.md.
#
#   evals/retrieval/label --help
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

# Settings come from .env at the repository root: KEY=value lines. A nonempty value in .env wins over the shell; see lib/env.sh.
source lib/env.sh

command -v bun > /dev/null || { echo "retrieval: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/label.ts" "$@"
