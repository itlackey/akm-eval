#!/usr/bin/env bash
# Grades the pooled results for each task query with the judge model, into assets/qrels.jsonl, or with --corpus own into
# private/retrieval/own/qrels.jsonl. With --from it grades the results of a run, the semantic search included. See README.md.
#
#   evals/retrieval/label [--corpus public|own] [--limit N] [--from RESULTS_DIR] [--judge-model ID] [--akm COMMAND]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

# Settings come from .env at the repository root: KEY=value lines. A variable that is already set wins. See lib/env.sh.
source lib/env.sh

command -v bun > /dev/null || { echo "retrieval: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/label.ts" "$@"
