#!/usr/bin/env bash
# Runs the judge-gate eval. See README.md.
#
#   evals/judge-gate/run --help
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

# Settings come from .env at the repository root: KEY=value lines. A nonempty value in .env wins over the shell; see lib/env.sh.
source lib/env.sh

command -v bun > /dev/null || { echo "judge-gate: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/run.ts" "$@"
