#!/usr/bin/env bash
# Makes this eval's private assets from the public ones. ./generate-assets calls it. See README.md.
#
#   evals/judge-gate/generate --seed N --out private/judge-gate
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

command -v bun > /dev/null || { echo "judge-gate: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/generate.ts" "$@"
