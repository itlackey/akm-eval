#!/usr/bin/env bash
# Replays akm's reflect defect filter on labelled edits. A --reflect run is replayed only against the cases and the code it ran on
# (assets_sha256 and harness_sha256 in its summary.json), unless --rescore says to use the ones here now. See README.md.
#
#   evals/reflect/defect-filter --akm-src DIR [--reflect RESULTS_DIR]... [--judge-gate public|private]... [--rescore]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

command -v bun > /dev/null || { echo "defect-filter: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/defect-filter.ts" "$@"
