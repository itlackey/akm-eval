#!/usr/bin/env bash
# Replays akm's reflect defect filter on labelled edits. The source of each edit of a --reflect run is read from the cases here now:
# a run with a case that no longer exists is refused, unless --rescore omits its proposals. See README.md.
#
#   evals/reflect/defect-filter --help
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

command -v bun > /dev/null || { echo "defect-filter: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/defect-filter.ts" "$@"
