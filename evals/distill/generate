#!/usr/bin/env bash
# Makes this eval's private assets from the public ones. ./generate-assets calls it. See README.md.
#
#   evals/distill/generate --seed N --out private/distill
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"

# Settings come from .env at the repository root: KEY=value lines. A variable that is already set wins. See lib/env.sh.
source lib/env.sh

command -v bun > /dev/null || { echo "distill: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/generate.ts" "$@"
