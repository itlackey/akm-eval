#!/usr/bin/env bash
# Replays distill's judge routing, with and without grounding in the pass bar, on the results of distill runs. The checks use the
# cases and the scorer here now: a run with a case that no longer exists is refused, unless --rescore omits its rows. See README.md.
#
#   evals/distill/pass-bar --help
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

command -v bun > /dev/null || { echo "pass-bar: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/pass-bar.ts" "$@"
