#!/usr/bin/env bash
# Replays distill's judge routing, with and without grounding in the pass bar, on the results of distill runs. A run is read only
# against the cases and the scorer it was scored by (the manifest in its summary.json), unless --rescore says to use the ones here now.
# See README.md.
#
#   evals/distill/pass-bar [--rescore] [--cases DIR] RESULTS_DIR...
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

command -v bun > /dev/null || { echo "pass-bar: bun is needed. See https://bun.sh" >&2; exit 2; }
exec bun "$here/src/pass-bar.ts" "$@"
