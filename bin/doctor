#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$BIN_DIR/.." && pwd)"

run_setup_script() {
  local pack_name="$1"
  local script_path="$2"

  if ! output="$(bash "$script_path" 2>&1)"; then
    output="${output//$'\n'/ }"
    printf 'WARN pack:%s: %s\n' "$pack_name" "${output:-runtime setup failed}"
    exit 0
  fi
}

pack_id=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  if [ "${args[$i]}" = "--pack" ] && [ $((i + 1)) -lt ${#args[@]} ]; then
    pack_id="${args[$((i + 1))]}"
    break
  fi
done

if [ "$pack_id" = "swe-bench" ]; then
  run_setup_script "swe-bench" "$REPO_ROOT/scripts/setup-swe-bench-runtime.sh"

  if ! command -v docker >/dev/null 2>&1; then
    printf 'WARN pack:swe-bench: Docker daemon unavailable: docker not found in PATH\n'
    exit 0
  fi

  if ! docker_version="$(docker info --format '{{.ServerVersion}}' 2>/dev/null)"; then
    docker_error="$(docker info --format '{{.ServerVersion}}' 2>&1 || true)"
    docker_error="${docker_error//$'\n'/ }"
    printf 'WARN pack:swe-bench: Docker daemon unavailable: %s\n' "${docker_error:-docker info failed}"
    exit 0
  fi

  printf 'OK pack:swe-bench: swe-bench runs through a host-side official harness wrapper with a repo-local uv-managed environment under .akm/evals/venvs/swe-bench; Docker host ready (%s).\n' "$docker_version"
  exit 0
fi

if [ "$pack_id" = "terminal-bench" ]; then
  run_setup_script "terminal-bench" "$REPO_ROOT/scripts/setup-terminal-bench-runtime.sh"

  if ! command -v docker >/dev/null 2>&1; then
    printf 'WARN pack:terminal-bench: Docker daemon unavailable: docker not found in PATH\n'
    exit 0
  fi

  if ! docker_version="$(docker info --format '{{.ServerVersion}}' 2>/dev/null)"; then
    docker_error="$(docker info --format '{{.ServerVersion}}' 2>&1 || true)"
    docker_error="${docker_error//$'\n'/ }"
    printf 'WARN pack:terminal-bench: Docker daemon unavailable: %s\n' "${docker_error:-docker info failed}"
    exit 0
  fi

  printf 'OK pack:terminal-bench: terminal-bench runs through the official host-side tb harness with a repo-local uv-managed environment under .akm/evals/venvs/terminal-bench; Docker host ready (%s).\n' "$docker_version"
  exit 0
fi

if [ "$pack_id" = "beam" ]; then
  if ! output="$(bash "$REPO_ROOT/scripts/setup-beam-runtime.sh" --require-judge 2>&1)"; then
    output="${output//$'\n'/ }"
    printf 'WARN pack:beam: %s\n' "${output:-beam runtime setup failed}"
    exit 0
  fi

  printf 'OK pack:beam: beam runtime setup and preflight passed; repo-local uv-managed environment ready under .akm/evals/venvs/beam.\n'
  exit 0
fi

exec "$BIN_DIR/akm-eval" doctor "$@"
