#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$BIN_DIR/.." && pwd)"

run_setup_script() {
  local pack_name="$1"
  local script_path="$2"

  if ! output="$(bash "$script_path" 2>&1)"; then
    output="${output//$'\n'/ }"
    printf 'WARN pack:%s: %s\n' "$pack_name" "${output:-runtime setup failed}"
    exit 0
  fi
}

pack_id=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  if [ "${args[$i]}" = "--pack" ] && [ $((i + 1)) -lt ${#args[@]} ]; then
    pack_id="${args[$((i + 1))]}"
    break
  fi
done

if [ "$pack_id" = "beam" ]; then
  if [ "${AKM_EVAL_IN_CONTAINER:-0}" != "1" ]; then
    export AKM_EVAL_IMAGE_FLAVOR=beam
    exec bash "$BIN_DIR/_akm_eval_cli_image.sh" bash "$REPO_ROOT/bin/doctor" "$@"
  fi

  if ! output="$(bash "$REPO_ROOT/scripts/setup-beam-runtime.sh" --check --require-judge 2>&1)"; then
    output="${output//$'\n'/ }"
    printf 'WARN pack:beam: %s\n' "${output:-beam runtime setup failed}"
    exit 0
  fi

  printf 'OK pack:beam: preinstalled container runtime and upstream BEAM preflight passed.\n'
  exit 0
fi

exec "$BIN_DIR/akm-eval" doctor "$@"
