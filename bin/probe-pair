#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$BIN_DIR/.." && pwd)"

control=""
candidate=""
expected_control_version=""
expected_candidate_commit=""
expected_control_commit=""
while [ $# -gt 0 ]; do
  case "$1" in
    --control) control="${2:?--control requires a probe artifact directory}"; shift 2 ;;
    --candidate) candidate="${2:?--candidate requires a probe artifact directory}"; shift 2 ;;
    --expected-control-version) expected_control_version="${2:?--expected-control-version requires a version}"; shift 2 ;;
    --expected-candidate-commit) expected_candidate_commit="${2:?--expected-candidate-commit requires a 40-hex SHA}"; shift 2 ;;
    --expected-control-commit) expected_control_commit="${2:?--expected-control-commit requires a 40-hex SHA}"; shift 2 ;;
    -h|--help) echo 'usage: bin/probe-pair --control <probe-dir> --candidate <probe-dir>'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
[ -n "$control" ] && [ -n "$candidate" ] && [ -n "$expected_control_version" ] && [ -n "$expected_candidate_commit" ] || { echo 'control, candidate, expected control version, and expected candidate commit are required' >&2; exit 2; }
[[ "$expected_candidate_commit" =~ ^[0-9a-f]{40}$ ]] || { echo 'expected candidate commit must be a 40-hex SHA' >&2; exit 2; }

out="$candidate/paired-verdict.json"
extra=()
[ -n "$expected_control_commit" ] && extra=(--expected-control-commit "$expected_control_commit")
if ! (cd "$REPO_ROOT" && bun scripts/probes/paired-grade.ts --control "$control" --candidate "$candidate" --out "$out" --expected-control-version "$expected_control_version" --expected-candidate-commit "$expected_candidate_commit" "${extra[@]}"); then
  echo "probe-pair: FAILED — inspect $out" >&2
  exit 1
fi
echo "probe-pair: passed — $out"
