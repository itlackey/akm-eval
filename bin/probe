#!/usr/bin/env bash
set -euo pipefail

# One-command Tier-1 retrieval probe: select an image containing a pinned
# akm-cli, run BOTH packs' LLM-free probes, capture the logs, and record an
# informational comparison against the historical reference values.
#
#   bin/probe --akm-version 0.9.14-beta.1
#   bin/probe 0.9.10          # positional compatibility alias
#   bin/probe --cmd '["/path/to/akm"]'   # probe an already-installed binary
#   bin/probe --identity-permutation 0.9.13  # also gate filename/slug independence
#
# Free and deterministic (no LLM). It runs in Docker so the host needs no
# Bun/npm/jq. Run this BEFORE judged budget; use bin/probe-pair for the gate.

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$BIN_DIR/.." && pwd)"

usage() {
  printf '%s\n' \
    'usage: bin/probe --akm-version VERSION [--identity-permutation]' \
    '       bin/probe --cmd '\''["/absolute/path/to/akm"]'\'' [--identity-permutation]'
}

if [ "${AKM_EVAL_IN_CONTAINER:-0}" != "1" ]; then
  requested_version=""
  has_custom_command=0
  wants_help=0
  outer_args=("$@")
  for ((i = 0; i < ${#outer_args[@]}; i++)); do
    case "${outer_args[$i]}" in
      --akm-version)
        requested_version="${outer_args[$((i + 1))]:?--akm-version requires a value}"
        i=$((i + 1))
        ;;
      --cmd)
        has_custom_command=1
        i=$((i + 1))
        ;;
      -h|--help) wants_help=1 ;;
      --identity-permutation) ;;
      -*) ;;
      *) requested_version="${outer_args[$i]}" ;;
    esac
  done
  if [ "$wants_help" = "1" ]; then
    usage
    exit 0
  fi
  if [ "$wants_help" = "0" ] && [ -z "$requested_version" ] && [ "$has_custom_command" = "0" ]; then
    echo "probe: select an exact target with --akm-version VERSION (or use --cmd)" >&2
    exit 2
  fi
  if [ -n "$requested_version" ]; then
    export AKM_EVAL_AKM_VERSION="$requested_version"
  fi
  exec bash "$BIN_DIR/_akm_eval_cli_image.sh" bash "$REPO_ROOT/bin/probe" "$@"
fi

required_bun="1.3.13"
actual_bun="$(bun --version 2>/dev/null || true)"
[ "$actual_bun" = "$required_bun" ] || { echo "probe: requires Bun $required_bun (found ${actual_bun:-missing})" >&2; exit 2; }

# Historical values retained only for continuity with old run records. Sourced from
# runs/RESULTS-n25-0.9.3.md Phase 1 and reproduced unchanged on 0.9.10.
# Keep in sync with the table in scripts/probes/README.md.
REFERENCE_JSON='{
  "locomo":      {"zeroHitRate": 0.0, "evidenceRecallAt5": 0.590, "precisionAtK": 0.232917, "recallAtK": 0.497917},
  "longmemeval": {"zeroHitRate": 0.0, "evidenceRecallAt5": 0.950, "precisionAtK": 0.676667, "recallAtK": 0.950000}
}'
REFERENCE_FROM="akm-cli 0.9.3 / 0.9.10"
# A metric may drift by this much before it is called a historical change. mrr/ndcg moved
# ~0.002 between 0.9.3 and 0.9.10 with an identical retrieved set, so anything
# under this is ranking jitter, not a retrieval change.
TOLERANCE=0.005

version=""
akm_cmd=""
identity_permutation_check=0
while [ $# -gt 0 ]; do
  case "$1" in
    --cmd) akm_cmd="${2:?--cmd requires a JSON argv array}"; shift 2 ;;
    --akm-version) version="${2:?--akm-version requires a value}"; shift 2 ;;
    --identity-permutation) identity_permutation_check=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) version="$1"; shift ;;
  esac
done

if [ -n "$akm_cmd" ] && [ -n "$version" ]; then
  echo "probe: pass --akm-version (or a positional version) OR --cmd, not both" >&2
  exit 2
fi

# ---------------------------------------------------------------- resolve akm
if [ -z "$akm_cmd" ]; then
  version="${version:-${AKM_EVAL_AKM_VERSION:-}}"
  [ -n "$version" ] || { echo "probe: no AKM version selected" >&2; exit 2; }
  akm_cmd='["akm"]'
  label="$version"
else
  label="custom"
fi

# NEVER let a probe fall back to the real stash. akm resolves bundleDir to
# ~/akm from default config when no AKM_*_DIR overrides are set; the probe
# pins its own hermetic dirs, but resolving the version must not.
if ! jq -e 'type == "array" and length > 0 and all(.[]; type == "string" and length > 0)' \
  >/dev/null <<<"$akm_cmd"; then
  echo "probe: --cmd must be a non-empty JSON argv array of strings" >&2
  exit 2
fi
mapfile -t akm_argv < <(jq -r '.[]' <<<"$akm_cmd")
# Pin ALL FIVE akm dirs, not just the bundle. akm resolves the others from
# default config independently, so pinning one leaves AKM_DATA_DIR on the
# user's real stash -- which is where index.db lives, and where a stray lock
# would block their everyday akm use. The probe body is already hermetic; this
# is the version check, which was not.
_akm_tmp="$(mktemp -d)"
trap 'rm -rf "$_akm_tmp"' EXIT
resolved_version="$(
  AKM_BUNDLE_DIR="$_akm_tmp/bundle" AKM_CONFIG_DIR="$_akm_tmp/config" \
  AKM_DATA_DIR="$_akm_tmp/data" AKM_CACHE_DIR="$_akm_tmp/cache" \
  AKM_STATE_DIR="$_akm_tmp/state" \
  "${akm_argv[@]}" --version 2>/dev/null || echo unknown
)"
[ "$label" = "custom" ] && label="$resolved_version"
if [ -n "$version" ] && [ "$resolved_version" != "$version" ]; then
  echo "probe: selected akm-cli $version but command resolved to ${resolved_version}; rebuild/select the matching image" >&2
  exit 2
fi

# ------------------------------------------------------------------- run them
stamp="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
out_dir="$REPO_ROOT/runs/probes/${label}-${stamp}"
mkdir -p "$out_dir"

echo "probe: akm-cli ${resolved_version} -> runs/probes/${label}-${stamp}/"
echo

status=0
for pack in locomo longmemeval; do
  echo "probe: running ${pack}..."
  # MAX_Q=20 on longmemeval is what every committed reference number used;
  # locomo's 40 questions are the whole conv-26 slice and need no cap.
  env_max_q=()
  [ "$pack" = "longmemeval" ] && env_max_q=(MAX_Q=20)
  identity_check_env=()
  [ "$identity_permutation_check" -eq 1 ] && identity_check_env=(IDENTITY_PERMUTATION_CHECK=1)
  if ! ( cd "$REPO_ROOT" && env AKM_EVAL_AKM_CMD="$akm_cmd" AKM_EVAL_TARGET_VERSION="$resolved_version" "${env_max_q[@]}" "${identity_check_env[@]}" \
           bun scripts/probes/retrieval-probe.ts "$pack" ) \
         > "$out_dir/$pack.json" 2> "$out_dir/$pack.log"; then
    echo "probe: ${pack} FAILED -- see runs/probes/${label}-${stamp}/${pack}.log" >&2
    cat "$out_dir/$pack.log" >&2
    status=1
    continue
  fi
done
[ "$status" -ne 0 ] && exit "$status"

# -------------------------------------------------------------------- grade it
jq -n \
  --argjson reference "$REFERENCE_JSON" \
  --argjson tolerance "$TOLERANCE" \
  --arg reference_from "$REFERENCE_FROM" \
  --arg version "$resolved_version" \
  --slurpfile locomo "$out_dir/locomo.json" \
  --slurpfile longmemeval "$out_dir/longmemeval.json" '
  def metrics($r): {
    zeroHitRate: $r.zeroHitRate,
    evidenceRecallAt5: $r.evidenceRecallAt5,
    precisionAtK: $r.retrieval.precisionAtK,
    recallAtK: $r.retrieval.recallAtK,
  };
  # zeroHitRate is the one metric where LOWER is better; every other metric
  # here is a score. Grading the wrong direction would call a fix a regression.
  def verdict($name; $got; $want):
    ($got - $want) as $delta
    | (if $name == "zeroHitRate" then -$delta else $delta end) as $signed
    | if ($delta | fabs) <= $tolerance then "match"
      elif $signed > 0 then "IMPROVED"
      else "REGRESSED" end;

  { akmVersion: $version, referenceFrom: $reference_from, tolerance: $tolerance,
    guardTripped: { locomo: $locomo[0].guardTripped, longmemeval: $longmemeval[0].guardTripped },
    packs: [
      {pack: "locomo", got: metrics($locomo[0]), want: $reference.locomo},
      {pack: "longmemeval", got: metrics($longmemeval[0]), want: $reference.longmemeval}
    ] | map(. as $p | $p.got | to_entries | map({
        pack: $p.pack, metric: .key, got: .value, want: $p.want[.key],
        delta: (.value - $p.want[.key]),
        verdict: verdict(.key; .value; $p.want[.key])
      })) | flatten
  }' > "$out_dir/verdict.json"

{
  printf '# Retrieval probe — akm-cli %s\n\n' "$resolved_version"
  printf 'Run: %s · reference: %s · tolerance: ±%s\n\n' "$stamp" "$REFERENCE_FROM" "$TOLERANCE"
  printf '| pack | metric | reference | measured | delta | verdict |\n'
  printf '| --- | --- | --- | --- | --- | --- |\n'
  jq -r '.packs[] | "| \(.pack) | \(.metric) | \(.want) | \(.got) | \(if .delta >= 0 then "+" else "" end)\(.delta * 1000000 | round / 1000000) | \(.verdict) |"' "$out_dir/verdict.json"
  printf '\nguardTripped: '
  jq -r '.guardTripped | to_entries | map("\(.key)=\(.value)") | join(", ")' "$out_dir/verdict.json"
  [ "$identity_permutation_check" -eq 1 ] && printf 'identityPermutation: passed\n'
  printf '\n'
} > "$out_dir/summary.md"

cat "$out_dir/summary.md"
echo

# guardTripped counts queries the backend refused outright. They are excluded
# from the rates rather than counted as misses, so a nonzero count is a silent
# hole in the sample -- surface it as a finding, not a pass.
guards="$(jq -r '[.guardTripped[]] | add' "$out_dir/verdict.json")"
if [ "$guards" != "0" ]; then
  echo "probe: WARNING -- guardTripped=${guards}; those queries were refused, not scored." >&2
fi

if jq -e '[.packs[] | select(.verdict == "REGRESSED")] | length > 0' "$out_dir/verdict.json" >/dev/null; then
  echo "probe: differs from the stale historical reference; informational only. Use bin/probe-pair for release gating." >&2
  exit 0
fi
if jq -e '[.packs[] | select(.verdict == "IMPROVED")] | length > 0' "$out_dir/verdict.json" >/dev/null; then
  echo "probe: retrieval improved over the reference — update REFERENCE_JSON in this script once confirmed."
  exit 0
fi
echo "probe: no retrieval change vs ${REFERENCE_FROM}."
