#!/usr/bin/env bash
set -euo pipefail

# One-command memory eval with the credentials wired correctly.
#
#   bin/memory-eval longmemeval --akm-version 0.9.14-beta.1
#   bin/memory-eval locomo --variant akm-memory --akm-version 0.9.14-beta.1
#   bin/memory-eval longmemeval --akm-version 0.9.14-beta.1 --dry-run
#
# WHY THIS EXISTS: the judge and the agent need DIFFERENT credentials pointed
# at DIFFERENT endpoints, and they collide on the same variable name. The agent
# arms run on opencode Zen, which wants OPENAI_API_KEY set to the Zen key; the
# LongMemEval judge is gpt-4o, which Zen does not serve at all, so it needs a
# real OpenAI key. Wiring that by hand before a multi-hour run is exactly the
# kind of step that fails at the end instead of the start.

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$BIN_DIR/.." && pwd)"

usage() {
  printf '%s\n' \
    'usage: bin/memory-eval <longmemeval|locomo> --akm-version VERSION [--variant ID] [--dry-run]' \
    '       Omit --akm-version only when no akm-memory arm is selected.'
}

if [ "${AKM_EVAL_IN_CONTAINER:-0}" != "1" ]; then
  requested_version=""
  outer_args=("$@")
  for ((i = 0; i < ${#outer_args[@]}; i++)); do
    case "${outer_args[$i]}" in
      --akm-version)
        requested_version="${outer_args[$((i + 1))]:?--akm-version requires a value}"
        i=$((i + 1))
        ;;
      --variant) i=$((i + 1)) ;;
    esac
  done
  if [ "${outer_args[0]:-}" = "-h" ] || [ "${outer_args[0]:-}" = "--help" ]; then
    usage
    exit 0
  fi
  if [ -n "$requested_version" ]; then
    export AKM_EVAL_AKM_VERSION="$requested_version"
  fi
  exec bash "$BIN_DIR/_akm_eval_cli_image.sh" bash "$REPO_ROOT/bin/memory-eval" "$@"
fi

cd "$REPO_ROOT"

ZEN_BASE_URL="https://opencode.ai/zen/v1"
# Judge endpoint. Empty means cloud OpenAI, which is what LongMemEval's
# specified judge (gpt-4o) requires -- Zen serves no gpt-4 family, and ai.lab
# rejects every named model. Override only for a host that can actually serve
# the judge the benchmark names.
JUDGE_BASE_URL="${AKM_EVAL_JUDGE_BASE_URL:-}"

pack=""
variants=()
dry_run=0
requested_akm_version="${AKM_EVAL_AKM_VERSION:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    longmemeval|locomo) pack="$1"; shift ;;
    --variant) variants+=("${2:?--variant requires a value}"); shift 2 ;;
    --akm-version) requested_akm_version="${2:?--akm-version requires a value}"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "memory-eval: unexpected argument: $1" >&2; exit 2 ;;
  esac
done
[ -n "$pack" ] || { echo "memory-eval: which pack? 'longmemeval' or 'locomo'" >&2; exit 2; }
[ ${#variants[@]} -gt 0 ] || variants=(baseline raw-vector akm-memory)

config="config/common/${pack}-akm-ab-zen.json"
[ -f "$config" ] || { echo "memory-eval: missing $config" >&2; exit 1; }

fail() { echo "memory-eval: $*" >&2; exit 1; }

# Judged akm-memory runs require an explicit target version.  This prevents a
# stale baked CLI or an arbitrary old scratch glob from becoming the measured
# candidate.  AKM_EVAL_AKM_CMD remains supported, but must report that version.
needs_akm=0
for variant in "${variants[@]}"; do
  [ "$variant" = "akm-memory" ] && needs_akm=1
done
if [ "$needs_akm" = "1" ] && [ -z "$requested_akm_version" ]; then
  fail "akm-memory requires --akm-version VERSION (or AKM_EVAL_AKM_VERSION)."
fi

# Credentials are intentionally never fetched from the AKM CLI under test.
# Export the documented variables or point AKM_EVAL_ENV_FILE at a Docker env
# file.  This keeps secrets out of image layers and separates benchmark input
# from the target whose behavior is being measured.

# The judge key. Accept AKM_EVAL_JUDGE_API_KEY, or fall back to a real OpenAI
# key stored under the generic name -- but only after confirming it is NOT the
# Zen key, which would silently send Zen credentials to api.openai.com.
# The judge runs on ai.lab, so its key is LAB_API_KEY. An explicit
# AKM_EVAL_JUDGE_API_KEY still wins; the OPENAI_API_KEY fallback remains for a
# cloud-OpenAI judge, and is used only when the value differs from the Zen key
# so Zen credentials can never be sent to another host by a naming accident.
judge_key="${AKM_EVAL_JUDGE_API_KEY:-}"
if [ -z "$judge_key" ] && [ -n "${LAB_API_KEY:-}" ] && [ -n "$JUDGE_BASE_URL" ] \
   && [ "$JUDGE_BASE_URL" = "${LAB_AI_BASE_URL:-}" ]; then
  judge_key="$LAB_API_KEY"
fi
if [ -z "$judge_key" ] && [ -n "${OPENAI_API_KEY:-}" ] && [ "${OPENAI_API_KEY:-}" != "${OPENCODE_API_KEY:-}" ]; then
  judge_key="$OPENAI_API_KEY"
fi

[ -n "${OPENCODE_API_KEY:-}" ] || fail "OPENCODE_API_KEY is unset; the agent arms need it."

if [ "$pack" = "longmemeval" ]; then
  [ -n "$judge_key" ] || fail "no judge key for ${JUDGE_BASE_URL:-cloud OpenAI}. Set AKM_EVAL_JUDGE_API_KEY to a key that can serve $(jq -r '.packs[0].config.evaluatorModel' "$config")."
fi

# Agent arms -> Zen. Judge -> cloud OpenAI (no judge base URL, so
# resolveJudgeEnv clears the agent's and the key is never sent to Zen).
export OPENAI_API_KEY="$OPENCODE_API_KEY"
export OPENAI_BASE_URL="$ZEN_BASE_URL"
export AKM_EVAL_JUDGE_API_KEY="$judge_key"
# Unset, not empty: resolveJudgeEnv treats an absent judge base URL as "cloud
# OpenAI" and clears the agent's, so the judge key is never sent to Zen.
if [ -n "$JUDGE_BASE_URL" ]; then
  export AKM_EVAL_JUDGE_BASE_URL="$JUDGE_BASE_URL"
else
  unset AKM_EVAL_JUDGE_BASE_URL
fi

export AKM_EVAL_AKM_CMD="${AKM_EVAL_AKM_CMD:-[\"akm\"]}"

# Pin ALL FIVE akm dirs. Pinning only the bundle leaves AKM_DATA_DIR on the
# user's real stash (where index.db lives), so a version check could take a
# lock on the DB they use for everything else.
_akm_tmp="$(mktemp -d)"
trap 'rm -rf "$_akm_tmp"' EXIT
if ! jq -e 'type == "array" and length > 0 and all(.[]; type == "string" and length > 0)' \
  >/dev/null <<<"$AKM_EVAL_AKM_CMD"; then
  fail "AKM_EVAL_AKM_CMD must be a non-empty JSON argv array of strings"
fi
mapfile -t akm_argv < <(jq -r '.[]' <<<"$AKM_EVAL_AKM_CMD")
akm_version="$(
  AKM_BUNDLE_DIR="$_akm_tmp/bundle" AKM_CONFIG_DIR="$_akm_tmp/config" \
  AKM_DATA_DIR="$_akm_tmp/data" AKM_CACHE_DIR="$_akm_tmp/cache" \
  AKM_STATE_DIR="$_akm_tmp/state" \
  "${akm_argv[@]}" --version 2>/dev/null || echo unknown
)"
if [ "$needs_akm" = "1" ] && [ "$akm_version" != "$requested_akm_version" ]; then
  fail "requested akm-cli ${requested_akm_version}, but AKM_EVAL_AKM_CMD reports ${akm_version}."
fi

stamp="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
out_root="runs/${pack}-full-${stamp}"

cat <<INFO

memory-eval: pack        ${pack}
memory-eval: config      ${config}
memory-eval: arms        ${variants[*]}
memory-eval: agent       Zen (${ZEN_BASE_URL})
memory-eval: judge       $(jq -r '.packs[0].config.evaluatorModel // "deterministic (no judge)"' "$config") $([ -n "$judge_key" ] && echo "via ${JUDGE_BASE_URL:-cloud OpenAI}" || echo "")
memory-eval: questions   $(jq -r '.packs[0].config.maxQuestions // "ALL (no subset)"' "$config")
memory-eval: categories  $(jq -r 'if .packs[0].config.questionCategories then (.packs[0].config.questionCategories|join(",")) else "ALL" end' "$config")
memory-eval: akm-cli     ${akm_version}
memory-eval: output      ${out_root}/

INFO

if [ "$dry_run" = "1" ]; then
  echo "memory-eval: --dry-run, stopping before execution."
  exit 0
fi

mkdir -p "$out_root"
status=0
for variant in "${variants[@]}"; do
  echo "memory-eval: === ${pack} / ${variant} ==="
  if ! bin/eval --pack "$pack" --variant "$variant" --config "$config" \
        --out "${out_root}/${variant}" 2>&1 | tee "${out_root}/${variant}.log"; then
    echo "memory-eval: ${variant} FAILED (see ${out_root}/${variant}.log)" >&2
    status=1
  fi
done

echo
echo "memory-eval: done -> ${out_root}/"
bin/summary --runs "$out_root" --format markdown 2>/dev/null | tee "${out_root}/summary.md" || true
exit "$status"
