#!/usr/bin/env bash
set -euo pipefail

# One-command memory eval with the credentials wired correctly.
#
#   bin/memory-eval longmemeval --akm-version 0.9.16 --out runs/longmemeval-0.9.16
#   bin/memory-eval locomo --variant akm-memory --akm-version 0.9.16
#   bin/memory-eval longmemeval --akm-version 0.9.16 --dry-run
#   bin/memory-eval longmemeval --akm-source ../akm --variant akm-memory-lead
#
# WHY THIS EXISTS: the judge and answer model may use different credentials and
# endpoints. The wrapper resolves the providers selected by the requested arms,
# validates their env placeholders up front, and never infers routing from a
# provider's arbitrary config key.

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$BIN_DIR/.." && pwd)"

usage() {
  printf '%s\n' \
    'usage: bin/memory-eval <longmemeval|locomo> (--akm-version VERSION | --akm-source DIR) [--config PATH] [--variant ID] [--out runs/DIR] [--parallel] [--dry-run]' \
    '       Omit the AKM target only when no akm-memory arm is selected.'
}

if [ "${AKM_EVAL_IN_CONTAINER:-0}" != "1" ]; then
  requested_version=""
  requested_source=""
  outer_args=("$@")
  for ((i = 0; i < ${#outer_args[@]}; i++)); do
    case "${outer_args[$i]}" in
      --akm-version)
        requested_version="${outer_args[$((i + 1))]:?--akm-version requires a value}"
        i=$((i + 1))
        ;;
      --variant) i=$((i + 1)) ;;
      --config) i=$((i + 1)) ;;
      --out) i=$((i + 1)) ;;
      --akm-source)
        requested_source="${outer_args[$((i + 1))]:?--akm-source requires a directory}"
        i=$((i + 1))
        ;;
    esac
  done
  if [ "${outer_args[0]:-}" = "-h" ] || [ "${outer_args[0]:-}" = "--help" ]; then
    usage
    exit 0
  fi
  if [ -n "$requested_version" ]; then
    export AKM_EVAL_AKM_VERSION="$requested_version"
  fi
  if [ -n "$requested_source" ]; then
    export AKM_EVAL_AKM_SOURCE_DIR="$requested_source"
  fi
  exec bash "$BIN_DIR/_akm_eval_cli_image.sh" bash "$REPO_ROOT/bin/memory-eval" "$@"
fi

cd "$REPO_ROOT"

ZEN_BASE_URL="https://opencode.ai/zen/v1"
# Judge endpoint. Empty means cloud OpenAI, which is what LongMemEval's
# specified judge (gpt-4o) requires -- Zen serves no gpt-4 family, and ai.lab
# rejects every named model. Override only for a host that can actually serve
# the judge the benchmark names.
JUDGE_BASE_URL="${AKM_EVAL_JUDGE_BASE_URL:-}"

pack=""
variants=()
dry_run=0
parallel=0
requested_akm_version="${AKM_EVAL_AKM_VERSION:-}"
requested_akm_source="${AKM_EVAL_AKM_SOURCE_DIR:-}"
config_override=""
requested_output=""
while [ $# -gt 0 ]; do
  case "$1" in
    longmemeval|locomo) pack="$1"; shift ;;
    --variant) variants+=("${2:?--variant requires a value}"); shift 2 ;;
    --akm-version) requested_akm_version="${2:?--akm-version requires a value}"; shift 2 ;;
    --akm-source) requested_akm_source="${2:?--akm-source requires a directory}"; shift 2 ;;
    --config) config_override="${2:?--config requires a path}"; shift 2 ;;
    --out) requested_output="${2:?--out requires a path}"; shift 2 ;;
    --parallel) parallel=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "memory-eval: unexpected argument: $1" >&2; exit 2 ;;
  esac
done
[ -n "$pack" ] || { echo "memory-eval: which pack? 'longmemeval' or 'locomo'" >&2; exit 2; }

config="${config_override:-config/common/${pack}-akm-ab-zen.json}"
[ -f "$config" ] || { echo "memory-eval: missing $config" >&2; exit 1; }
[ ${#variants[@]} -gt 0 ] || mapfile -t variants < <(jq -r '.variants[].id' "$config")

fail() { echo "memory-eval: $*" >&2; exit 1; }

# Judged akm-memory runs require an explicit target version.  This prevents a
# stale baked CLI or an arbitrary old scratch glob from becoming the measured
# candidate.  AKM_EVAL_AKM_CMD remains supported, but must report that version.
needs_akm=0
for variant in "${variants[@]}"; do
  jq -e --arg id "$variant" '.variants | any(.id == $id)' "$config" >/dev/null ||
    fail "config has no variant named ${variant}."
  case "$variant" in akm-memory*) needs_akm=1 ;; esac
done
if [ -n "$requested_akm_version" ] && [ -n "$requested_akm_source" ]; then
  fail "--akm-version and --akm-source are mutually exclusive."
fi
if [ "$needs_akm" = "1" ] && [ -z "$requested_akm_version" ] && [ -z "$requested_akm_source" ]; then
  fail "akm-memory requires --akm-version VERSION or --akm-source DIR."
fi

# Credentials are intentionally never fetched from the AKM CLI under test.
# Export the documented variables or point AKM_EVAL_ENV_FILE at a Docker env
# file.  This keeps secrets out of image layers and separates benchmark input
# from the target whose behavior is being measured.

ambient_openai_key="${OPENAI_API_KEY:-}"

# Backward-compatible Zen convenience: old configs reference OPENAI_API_KEY,
# but operators store the agent credential as OPENCODE_API_KEY so the cloud
# judge key cannot be confused with it. Routing is identified by the declared
# endpoint, not by providerRef.
uses_zen=0
for variant in "${variants[@]}"; do
  provider_ref="$(jq -r --arg id "$variant" '.variants[] | select(.id == $id) | (.agent.providerRef // .agent.provider)' "$config")"
  provider_base="$(jq -r --arg ref "$provider_ref" '.providers[$ref].baseURL // ""' "$config")"
  if [ "$provider_base" = "$ZEN_BASE_URL" ]; then
    uses_zen=1
  fi
done
if [ "$uses_zen" = "1" ]; then
  [ -n "${OPENCODE_API_KEY:-}" ] || fail "OPENCODE_API_KEY is unset; the selected Zen endpoint needs it."
  export OPENAI_API_KEY="$OPENCODE_API_KEY"
  export OPENAI_BASE_URL="$ZEN_BASE_URL"
fi

resolve_provider_value() {
  local raw="$1"
  local field="$2"
  local env_name
  if [[ "$raw" =~ ^\{env:([A-Z_][A-Z0-9_]*)\}$ ]]; then
    env_name="${BASH_REMATCH[1]}"
    [ -n "${!env_name:-}" ] || fail "$env_name is unset; selected provider field $field requires it."
    printf '%s\n' "${!env_name}"
  else
    printf '%s\n' "$raw"
  fi
}

declare -A seen_providers=()
agent_labels=()
agent_endpoints=()
agent_keys=()
for variant in "${variants[@]}"; do
  provider_ref="$(jq -r --arg id "$variant" '.variants[] | select(.id == $id) | (.agent.providerRef // .agent.provider)' "$config")"
  [ -n "$provider_ref" ] || fail "variant ${variant} has no provider reference."
  if [ -n "${seen_providers[$provider_ref]:-}" ]; then
    continue
  fi
  seen_providers[$provider_ref]=1
  jq -e --arg ref "$provider_ref" '.providers[$ref] | type == "object"' "$config" >/dev/null ||
    fail "config has no provider named ${provider_ref}."
  provider_type="$(jq -r --arg ref "$provider_ref" '.providers[$ref].type' "$config")"
  provider_base_raw="$(jq -r --arg ref "$provider_ref" '.providers[$ref].baseURL // ""' "$config")"
  provider_key_raw="$(jq -r --arg ref "$provider_ref" '.providers[$ref].apiKey // ""' "$config")"
  provider_base="$(resolve_provider_value "$provider_base_raw" "${provider_ref}.baseURL")"
  provider_key=""
  if [ -n "$provider_key_raw" ]; then
    provider_key="$(resolve_provider_value "$provider_key_raw" "${provider_ref}.apiKey")"
  fi
  if [ "$provider_type" = "openai-compatible" ]; then
    [ -n "$provider_base" ] || fail "selected openai-compatible provider ${provider_ref} has no baseURL."
  fi
  agent_labels+=("${provider_ref} (${provider_base:-$provider_type})")
  agent_endpoints+=("$provider_base")
  agent_keys+=("$provider_key")
done
agent_label="$(IFS=', '; printf '%s' "${agent_labels[*]}")"

# The explicit judge credential wins. A judge deliberately routed to one of
# the selected agent endpoints may reuse that endpoint's credential. Cloud
# OpenAI can fall back to the ambient OPENAI_API_KEY only when it was not the
# Zen credential.
judge_key="${AKM_EVAL_JUDGE_API_KEY:-}"
if [ -z "$judge_key" ] && [ -n "$JUDGE_BASE_URL" ]; then
  for ((i = 0; i < ${#agent_endpoints[@]}; i++)); do
    if [ "$JUDGE_BASE_URL" = "${agent_endpoints[$i]}" ]; then
      judge_key="${agent_keys[$i]}"
      break
    fi
  done
fi
if [ -z "$judge_key" ] && [ -n "$ambient_openai_key" ] && [ "$ambient_openai_key" != "${OPENCODE_API_KEY:-}" ]; then
  judge_key="$ambient_openai_key"
fi

if [ "$pack" = "longmemeval" ]; then
  [ -n "$judge_key" ] || fail "no judge key for ${JUDGE_BASE_URL:-cloud OpenAI}. Set AKM_EVAL_JUDGE_API_KEY to a key that can serve $(jq -r '.packs[0].config.evaluatorModel' "$config")."
fi

export AKM_EVAL_JUDGE_API_KEY="$judge_key"
# Unset, not empty: resolveJudgeEnv treats an absent judge base URL as "cloud
# OpenAI" and clears the agent's, so the judge key is never sent to Zen.
if [ -n "$JUDGE_BASE_URL" ]; then
  export AKM_EVAL_JUDGE_BASE_URL="$JUDGE_BASE_URL"
else
  unset AKM_EVAL_JUDGE_BASE_URL
fi

export AKM_EVAL_AKM_CMD="${AKM_EVAL_AKM_CMD:-[\"akm\"]}"

# Pin ALL FIVE akm dirs. Pinning only the bundle leaves AKM_DATA_DIR on the
# user's real stash (where index.db lives), so a version check could take a
# lock on the DB they use for everything else.
_akm_tmp="$(mktemp -d)"
trap 'rm -rf "$_akm_tmp"' EXIT
if ! jq -e 'type == "array" and length > 0 and all(.[]; type == "string" and length > 0)' \
  >/dev/null <<<"$AKM_EVAL_AKM_CMD"; then
  fail "AKM_EVAL_AKM_CMD must be a non-empty JSON argv array of strings"
fi
mapfile -t akm_argv < <(jq -r '.[]' <<<"$AKM_EVAL_AKM_CMD")
akm_version="$(
  AKM_BUNDLE_DIR="$_akm_tmp/bundle" AKM_CONFIG_DIR="$_akm_tmp/config" \
  AKM_DATA_DIR="$_akm_tmp/data" AKM_CACHE_DIR="$_akm_tmp/cache" \
  AKM_STATE_DIR="$_akm_tmp/state" \
  "${akm_argv[@]}" --version 2>/dev/null || echo unknown
)"
if [ "$needs_akm" = "1" ] && [ -n "$requested_akm_version" ] && [ "$akm_version" != "$requested_akm_version" ]; then
  fail "requested akm-cli ${requested_akm_version}, but AKM_EVAL_AKM_CMD reports ${akm_version}."
fi

if [ -n "$requested_output" ]; then
  runs_root="$(realpath -m -- "$REPO_ROOT/runs")"
  case "$requested_output" in
    /*) output_candidate="$requested_output" ;;
    *) output_candidate="$REPO_ROOT/$requested_output" ;;
  esac
  out_root="$(realpath -m -- "$output_candidate")"
  case "$out_root" in
    "$runs_root"/*) ;;
    *) fail "--out must resolve beneath $runs_root so the Docker wrapper can persist checkpoints safely." ;;
  esac
else
  stamp="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
  out_root="runs/${pack}-full-${stamp}"
fi

if [ "$pack" = "longmemeval" ]; then
  judge_summary="$(jq -r '.packs[0].config.evaluatorModel' "$config") via ${JUDGE_BASE_URL:-cloud OpenAI}"
else
  judge_summary="deterministic (no LLM judge)"
fi

cat <<INFO

memory-eval: pack        ${pack}
memory-eval: config      ${config}
memory-eval: arms        ${variants[*]}
memory-eval: execution   $([ "$parallel" = "1" ] && echo parallel || echo sequential)
memory-eval: agent       ${agent_label}
memory-eval: judge       ${judge_summary}
memory-eval: questions   $(jq -r '.packs[0].config.maxQuestions // "ALL (no subset)"' "$config")
memory-eval: categories  $(jq -r 'if .packs[0].config.questionCategories then (.packs[0].config.questionCategories|join(",")) else "ALL" end' "$config")
memory-eval: akm-cli     ${akm_version}
memory-eval: akm-source  ${AKM_EVAL_AKM_SOURCE_SHA:-published-package}${AKM_EVAL_AKM_SOURCE_DIR:+ (read-only mount: $AKM_EVAL_AKM_SOURCE_DIR)}
memory-eval: akm-tree    ${AKM_EVAL_AKM_SOURCE_FINGERPRINT:-n/a}${AKM_EVAL_AKM_SOURCE_DIRTY:+ (dirty=$AKM_EVAL_AKM_SOURCE_DIRTY)}
memory-eval: output      ${out_root}/

INFO

if [ "$dry_run" = "1" ]; then
  echo "memory-eval: --dry-run, stopping before execution."
  exit 0
fi

mkdir -p "$out_root"
status=0
run_variant() {
  local variant="$1"
  echo "memory-eval: === ${pack} / ${variant} ==="
  bin/eval --pack "$pack" --variant "$variant" --config "$config" \
    --out "${out_root}/${variant}" 2>&1 | tee "${out_root}/${variant}.log"
}

if [ "$parallel" = "1" ] && [ ${#variants[@]} -gt 1 ]; then
  pids=()
  for variant in "${variants[@]}"; do
    run_variant "$variant" &
    pids+=("$!")
  done
  for ((i = 0; i < ${#pids[@]}; i++)); do
    if ! wait "${pids[$i]}"; then
      echo "memory-eval: ${variants[$i]} FAILED (see ${out_root}/${variants[$i]}.log)" >&2
      status=1
    fi
  done
else
  for variant in "${variants[@]}"; do
    if ! run_variant "$variant"; then
      echo "memory-eval: ${variant} FAILED (see ${out_root}/${variant}.log)" >&2
      status=1
    fi
  done
fi

echo
echo "memory-eval: done -> ${out_root}/"
bin/summary --runs "$out_root" --format markdown 2>/dev/null | tee "${out_root}/summary.md" || true
exit "$status"
