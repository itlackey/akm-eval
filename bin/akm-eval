#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$BIN_DIR/.." && pwd)"

usage() {
  printf '%s\n' \
    'Usage:' \
    '  bin/doctor [--pack <id>]' \
    '  bin/akm-eval list packs' \
    '  bin/akm-eval list variants' \
    '  bin/eval --pack <id> --variant <id> --config <path> [--out <dir>]' \
    '  bin/matrix --config <path>' \
    '  bin/compare --baseline <dir> --candidate <dir> [--out <path>] [--format markdown|json]' \
    '  bin/report --run <dir> [--format markdown|json]' \
    '  bin/summary --runs <dir> [--format markdown|json]' \
    '  bin/downloads [LongMemEval|LoCoMo]'
}

if [ "${AKM_EVAL_IN_CONTAINER:-0}" = "1" ]; then
  exec bun "$REPO_ROOT/src/cli.ts" "$@"
fi

if [ $# -eq 0 ]; then
  usage
  exit 1
fi
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || \
   [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; then
  usage
  exit 0
fi

exec bash "$BIN_DIR/_akm_eval_cli_image.sh" bun "$REPO_ROOT/src/cli.ts" "$@"
