{
  "schemaVersion": "akm.eval.config.v1",
  "run": {
    "id": "beam-smoke",
    "outputDir": "runs/beam-smoke"
  },
  "packs": [
    {
      "id": "beam",
      "adapter": "beam",
      "enabled": true,
      "config": {
        "repoPath": "vendor/BEAM",
        "pythonBin": "python3.11",
        "chatSizes": ["100K"],
        "smoke": true,
        "maxConversations": 1,
        "maxQuestionsPerType": 1,
        "evaluatorModel": "gpt-4.1-mini"
      }
    }
  ],
  "variants": [
    {
      "id": "baseline",
      "agent": { "provider": "openai-compatible", "providerRef": "openai-compatible", "model": "gpt-4o-mini" },
      "akm": { "enabled": false },
      "memory": { "backend": "none" }
    },
    {
      "id": "akm-memory",
      "agent": { "provider": "openai-compatible", "providerRef": "openai-compatible", "model": "gpt-4o-mini" },
      "akm": { "enabled": true, "command": "akm" },
      "memory": { "backend": "akm", "config": { "command": "akm memory" } }
    }
  ],
  "providers": {
    "openai-compatible": {
      "type": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "apiKey": "{env:OPENAI_API_KEY}",
      "defaultModel": "gpt-4o-mini"
    }
  }
}
