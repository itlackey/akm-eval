{
  "schemaVersion": "akm.eval.config.v1",
  "run": {
    "id": "memory-comparison-smoke",
    "outputDir": "runs/memory-comparison-smoke",
    "maxConcurrency": 1,
    "timeoutMs": 1800000
  },
  "packs": [
    {
      "id": "longmemeval-smoke",
      "adapter": "longmemeval",
      "enabled": true,
      "config": {
        "evaluatorCommand": "python scripts/longmemeval-evaluator.py",
        "evaluatorModel": "gpt-4o",
        "maxQuestions": 100,
        "questionCategories": ["single-session", "multi-session", "temporal", "preference"]
      }
    }
  ],
  "variants": [
    {
      "id": "baseline",
      "agent": { "provider": "openai-compatible", "providerRef": "openai-compatible", "model": "gpt-4o-mini" },
      "akm": { "enabled": false },
      "memory": { "backend": "none" }
    },
    {
      "id": "akm-memory",
      "agent": { "provider": "openai-compatible", "providerRef": "openai-compatible", "model": "gpt-4o-mini" },
      "akm": { "enabled": true, "command": "akm" },
      "memory": { "backend": "akm", "config": { "command": "akm memory" } }
    },
    {
      "id": "mem0-oss",
      "agent": { "provider": "openai-compatible", "providerRef": "openai-compatible", "model": "gpt-4o-mini" },
      "akm": { "enabled": false },
      "memory": { "backend": "mem0", "config": { "mode": "oss" } }
    },
    {
      "id": "raw-vector",
      "agent": { "provider": "openai-compatible", "providerRef": "openai-compatible", "model": "gpt-4o-mini" },
      "akm": { "enabled": false },
      "memory": { "backend": "raw-vector" }
    }
  ],
  "notes": [
    "This planned comparison config still includes blocked external memory backend variants for future integration work.",
    "Today only the baseline and raw-vector paths are truthful runnable benchmark choices in this repo.",
    "`akm-eval run` should fail fast for the akm-memory and mem0-oss variants until a real evaluated backend integration lands."
  ],
  "providers": {
    "openai-compatible": {
      "type": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "apiKey": "{env:OPENAI_API_KEY}",
      "defaultModel": "gpt-4o-mini"
    }
  },
  "judging": { "enabled": true, "provider": "openai", "model": "gpt-4.1-mini", "temperature": 0 },
  "telemetry": { "trackTokens": true, "trackCost": true, "trackLatency": true, "captureLogs": true }
}
