{
  "version": 1,
  "defaults": {
    "outputDir": "../../runs",
    "memoryBackend": "raw-vector"
  },
  "runs": [
    {
      "id": "demo-akm-bench",
      "pack": "akm-bench",
      "variant": "baseline",
      "agentProvider": "demo-openai",
      "agentModel": "gpt-4o-mini",
      "memoryBackend": "none",
      "memoryDocuments": [
        { "id": "doc-1", "text": "AKM uses adapter boundaries for optional integrations." },
        { "id": "doc-2", "text": "Raw vector search is deterministic in this skeleton." }
      ],
      "retrieval": {
        "query": "deterministic raw vector search",
        "relevantIds": ["doc-2"],
        "topK": 2
      },
      "answer": {
        "expected": "raw vector search is deterministic",
        "actual": "Raw vector search is deterministic."
      }
    }
  ],
  "providers": {
    "demo-openai": {
      "type": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "apiKey": "{env:OPENAI_API_KEY}",
      "defaultModel": "gpt-4o-mini"
    }
  }
}
