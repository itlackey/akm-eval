{
  "schemaVersion": "akm.eval.config.v1",
  "run": {
    "id": "locomo-shredder-qwen",
    "outputDir": "runs/locomo-shredder-qwen",
    "maxConcurrency": 1,
    "timeoutMs": 600000
  },
  "packs": [
    {
      "id": "locomo",
      "adapter": "locomo",
      "enabled": true,
      "config": {
        "smoke": true,
        "maxSamples": 1,
        "maxQuestions": 5,
        "topK": 5,
        "maxContextTokens": 16000,
        "evaluatorCommand": "python3 scripts/locomo-evaluator.py"
      }
    }
  ],
  "variants": [
    {
      "id": "baseline",
      "agent": { "provider": "openai-compatible", "providerRef": "shredder", "model": "qwen/qwen3.5-9b" },
      "akm": { "enabled": false },
      "memory": { "backend": "none" }
    }
  ],
  "providers": {
    "shredder": {
      "type": "openai-compatible",
      "baseURL": "http://192.168.0.99:1234/v1",
      "timeout": 600000,
      "defaultModel": "qwen/qwen3.5-9b"
    }
  },
  "judging": { "enabled": false },
  "telemetry": { "trackTokens": true, "trackCost": true, "trackLatency": true, "captureLogs": true }
}
