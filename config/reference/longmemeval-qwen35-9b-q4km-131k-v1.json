{
  "schemaVersion": "akm.eval.config.v1",
  "run": {
    "id": "longmemeval-qwen35-9b-q4km-131k-v1",
    "outputDir": "runs/longmemeval-qwen35-9b-q4km-131k-v1"
  },
  "packs": [
    {
      "id": "longmemeval-qwen35-9b-q4km-131k-v1",
      "adapter": "longmemeval",
      "enabled": true,
      "config": {
        "datasetPath": "datasets/longmemeval/dataset.json",
        "evaluatorCommand": "python3 scripts/longmemeval-evaluator.py",
        "evaluatorModel": "gpt-4o",
        "smoke": false,
        "resume": true,
        "topK": 5
      }
    }
  ],
  "variants": [
    {
      "id": "baseline",
      "agent": {
        "provider": "openai-compatible",
        "providerRef": "reference-baseline",
        "model": "qwen3.5-9b"
      },
      "akm": { "enabled": false },
      "memory": { "backend": "none" }
    },
    {
      "id": "raw-vector",
      "agent": {
        "provider": "openai-compatible",
        "providerRef": "reference-retrieval",
        "model": "qwen3.5-9b"
      },
      "akm": { "enabled": false },
      "memory": { "backend": "raw-vector" }
    },
    {
      "id": "akm-memory-lead",
      "agent": {
        "provider": "openai-compatible",
        "providerRef": "reference-retrieval",
        "model": "qwen3.5-9b"
      },
      "akm": { "enabled": false },
      "memory": {
        "backend": "akm",
        "config": {
          "fragmentContext": {
            "mode": "lead",
            "maxChars": 3200
          }
        }
      }
    }
  ],
  "providers": {
    "reference-baseline": {
      "type": "openai-compatible",
      "baseURL": "{env:AKM_EVAL_BASELINE_BASE_URL}",
      "apiKey": "{env:AKM_EVAL_AGENT_API_KEY}",
      "defaultModel": "qwen3.5-9b",
      "timeout": 600000,
      "options": {
        "temperature": 0,
        "max_tokens": 256,
        "seed": 1337,
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    "reference-retrieval": {
      "type": "openai-compatible",
      "baseURL": "{env:AKM_EVAL_RETRIEVAL_BASE_URL}",
      "apiKey": "{env:AKM_EVAL_AGENT_API_KEY}",
      "defaultModel": "qwen3.5-9b",
      "timeout": 600000,
      "options": {
        "temperature": 0,
        "max_tokens": 256,
        "seed": 1337,
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    }
  },
  "judging": {
    "enabled": true,
    "provider": "openai",
    "model": "gpt-4o",
    "temperature": 0
  },
  "telemetry": {
    "trackTokens": true,
    "trackCost": true,
    "trackLatency": true,
    "captureLogs": true
  },
  "notes": [
    "Reproduction config for the tracked full-500 Qwen 3.5 9B reference round. The immutable config actually used for that round is retained as results/reference/longmemeval-qwen35-9b-q4km-131k-v1/recorded-config.json.",
    "Baseline uses its own 131072-token endpoint. Raw-vector and AKM use a two-slot endpoint with 32768 tokens per slot. All three arms use identical model bytes and request options.",
    "Use bin/reference-eval rather than invoking this config directly: it verifies the frozen controls, requires explicit confirmation before rerunning them, and compares AKM-only runs against the compatible tracked controls."
  ]
}
