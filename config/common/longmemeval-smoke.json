{
  "schemaVersion": "akm.eval.config.v1",
  "run": {
    "id": "longmemeval-smoke",
    "outputDir": "runs/longmemeval-smoke"
  },
  "packs": [
    {
      "id": "longmemeval",
      "adapter": "longmemeval",
      "enabled": true,
      "config": {
        "evaluatorCommand": "python3 scripts/longmemeval-evaluator.py",
        "evaluatorModel": "gpt-4o",
        "smoke": true,
        "maxQuestions": 5,
        "questionCategories": [
          "single-session",
          "multi-session"
        ]
      }
    }
  ],
  "variants": [
    {
      "id": "baseline",
      "agent": {
        "provider": "openai-compatible",
        "providerRef": "openai-compatible",
        "model": "gpt-4o-mini"
      },
      "akm": {
        "enabled": false
      },
      "memory": {
        "backend": "none"
      }
    }
  ],
  "providers": {
    "openai-compatible": {
      "type": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "apiKey": "{env:OPENAI_API_KEY}",
      "defaultModel": "gpt-4o-mini"
    }
  },
  "judging": {
    "enabled": true,
    "provider": "openai",
    "model": "gpt-4.1-mini",
    "temperature": 0
  },
  "telemetry": {
    "trackTokens": true,
    "trackCost": true,
    "trackLatency": true,
    "captureLogs": true
  }
}
