{
  "schemaVersion": "akm.eval.config.v1",
  "run": {
    "id": "locomo-smoke",
    "outputDir": "runs/locomo-smoke"
  },
  "packs": [
    {
      "id": "locomo-smoke",
      "adapter": "locomo",
      "enabled": true,
      "config": {
        "smoke": true,
        "maxSamples": 1,
        "maxQuestions": 5,
        "topK": 5,
        "maxContextTokens": 16000,
        "evaluatorCommand": "python3 scripts/locomo-evaluator.py"
      }
    }
  ],
  "variants": [
    {
      "id": "baseline",
      "agent": { "provider": "openai-compatible", "providerRef": "openai-compatible", "model": "gpt-4o-mini" },
      "akm": { "enabled": false },
      "memory": { "backend": "none" }
    },
    {
      "id": "raw-vector",
      "agent": { "provider": "openai-compatible", "providerRef": "openai-compatible", "model": "gpt-4o-mini" },
      "akm": { "enabled": false },
      "memory": { "backend": "raw-vector" }
    }
  ],
  "providers": {
    "openai-compatible": {
      "type": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "apiKey": "{env:OPENAI_API_KEY}",
      "defaultModel": "gpt-4o-mini"
    }
  },
  "judging": { "enabled": true, "provider": "openai", "model": "gpt-4.1-mini", "temperature": 0 },
  "telemetry": { "trackTokens": true, "trackCost": true, "trackLatency": true, "captureLogs": true }
}
